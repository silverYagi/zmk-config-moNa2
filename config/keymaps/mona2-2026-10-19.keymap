/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp A    &mt LEFT_CONTROL S
                &mt LEFT_ALT D    &mt LEFT_SHIFT F    &kp G    &kp BACKSPACE    &kp H    &mt RIGHT_SHIFT J    &mt RIGHT_ALT K    &mt RIGHT_CONTROL L    &kp MINUS    &kp Z    &kp X    &kp C
                &kp V    &kp B    &mo 5    &mo 5    &kp N    &kp M    &kp COMMA    &kp PERIOD    &kp SLASH    &kp LEFT_CONTROL    &kp LEFT_GUI    &kp LEFT_ALT
                &mt LEFT_SHIFT SPACE    &mo 3    &mo 2    &kp RETURN    &mo 4    &to 1
            >;
        };

        onishi_layer {
            display-name = "ONISHI";
            bindings = <
                &kp Q    &kp L    &kp U    &kp COMMA    &kp PERIOD    &kp F    &kp W    &kp R    &kp Y    &kp P    &kp E    &mt LEFT_CONTROL I
                &mt LEFT_ALT A    &mt LEFT_SHIFT O    &kp MINUS    &trans    &kp K    &mt RIGHT_SHIFT T    &mt RIGHT_ALT N    &mt RIGHT_CONTROL S    &kp H    &kp Z    &kp X    &kp C
                &kp V    &kp SLASH    &trans    &trans    &kp G    &kp D    &kp M    &kp J    &kp B    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &to 0
            >;
        };

        symbol_num_layer {
            display-name = "SYMBOL_NUM";
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &none    &kp 34013221
                &kp 34013222    &kp EQUAL    &kp MINUS    &trans    &kp SEMICOLON    &kp SQT    &kp RIGHT_BRACKET    &kp NON_US_HASH    &kp INT3    &none    &none    &none
                &none    &none    &trans    &kp K_APPLICATION    &kp LEFT_BRACKET    &kp INT1    &kp COMMA    &kp PERIOD    &kp SLASH    &kp LEFT_CONTROL    &kp LEFT_GUI    &kp LEFT_ALT
                &mt LEFT_SHIFT SPACE    &mt LEFT_SHIFT SPACE    &trans    &none    &kp LEFT_SHIFT    &trans
            >;
        };

        mouce_fc_layer {
            display-name = "MOUCE_FC";
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10    &kp F11    &kp F12
                &none    &none    &none    &none    &none    &mkp MB1    &mkp MB3    &mkp MB2    &kp K_APPLICATION    &none    &none    &none
                &none    &none    &none    &none    &none    &none    &none    &none    &none    &kp LEFT_CONTROL    &kp LEFT_GUI    &kp LEFT_ALT
                &none    &none    &none    &trans    &trans    &trans
            >;
        };

        nav_sc_layer {
            display-name = "NAV_SC";
            bindings = <
                &kp ESCAPE    &none    &kp PRINTSCREEN    &none    &none    &kp HOME    &kp BACKSPACE    &kp DELETE    &kp END    &kp PAGE_UP    &kp TAB    &kp LEFT_CONTROL
                &kp LEFT_GUI    &none    &none    &trans    &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &kp K_APPLICATION    &kp 101122091    &none    &none
                &none    &none    &trans    &trans    &kp LANG2    &kp LANG1    &kp GRAVE    &kp INS    &kp PAGE_DOWN    &none    &trans    &tog 1
                &kp LEFT_SHIFT    &trans    &trans    &kp PRINTSCREEN    &mo 3    &none
            >;
        };

        ble_layer {
            display-name = "BLE";
            bindings = <
                &out OUT_USB    &out OUT_BLE    &none    &none    &none    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &none    &none
                &none    &none    &none    &none    &none    &none    &none    &none    &studio_unlock    &none    &none    &none
                &none    &none    &trans    &none    &none    &none    &none    &none    &bt BT_CLR    &none    &none    &none
                &none    &none    &none    &none    &none    &none
            >;
        };
    };
};
