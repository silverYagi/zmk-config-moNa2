/* Keyball39の個人用配列をmoNa2の42キーへ移植。 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define QWERTY 0
#define ONISHI 1
#define SYMBOL 2
#define NUMBER_NAV 3
#define FUNCTION 4
#define BLUETOOTH 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* 既定はQWERTY。ホーム行の長押し修飾キーもKeyball39と同じ。 */
        qwerty {
            display-name = "QWERTY";
            bindings = <
&kp Q       &kp W          &kp E         &kp R          &kp T                           &kp Y       &kp U          &kp I         &kp O          &kp P
&kp A       &mt LCTRL S    &mt LALT D    &mt LSHIFT F    &kp G                &kp BSPC   &kp H       &mt RSHIFT J   &mt RALT K    &mt RCTRL L    &kp MINUS
&kp Z       &kp X          &kp C         &kp V          &kp B  &mo BLUETOOTH &kp DEL    &kp N       &kp M          &kp COMMA     &kp DOT        &kp SLASH
&kp LCTRL   &kp LGUI       &kp LALT      &mt LSHIFT SPACE &mo SYMBOL &mo FUNCTION          &kp ENTER   &mo NUMBER_NAV                               &to ONISHI
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        /* 大西配列。右下のキーを押すとQWERTYへ戻る。 */
        onishi {
            display-name = "ONISHI";
            bindings = <
&kp Q       &kp L          &kp U         &kp COMMA      &kp DOT                         &kp F       &kp W          &kp R         &kp Y          &kp P
&kp E       &mt LCTRL I    &mt LALT A    &mt LSHIFT O    &kp MINUS             &trans     &kp K       &mt RSHIFT T   &mt RALT N    &mt RCTRL S    &kp H
&kp Z       &kp X          &kp C         &kp V          &kp SLASH &trans      &trans     &kp G       &kp D          &kp M         &kp J          &kp B
&trans      &trans         &trans        &mt LSHIFT SPACE &mo SYMBOL &mo FUNCTION         &kp ENTER   &mo NUMBER_NAV                               &to QWERTY
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        /* 記号は見た目の名称ではなく、元のQMKと同じHIDキーを送る。 */
        symbol {
            display-name = "SYMBOL";
            bindings = <
&kp RIGHT_BRACKET &kp BACKSLASH &kp INT3 &kp EQUAL      &kp LS(N1)                       &kp LS(EQUAL) &kp LS(N3)   &kp LS(LEFT_BRACKET) &kp LS(N5)   &kp LEFT_BRACKET
&kp LS(N8)  &kp LS(N9)     &kp SQT       &kp SEMI       &kp LS(N6)            &trans     &kp MINUS   &mkp MB1       &mkp MB3      &mkp MB2       &mt LSHIFT INT3
&kp LS(RIGHT_BRACKET) &kp LS(BACKSLASH) &kp LS(N7) &kp LS(N2) &kp LS(INT3) &trans &kp K_APP &kp LEFT_BRACKET &kp LS(N4) &kp LS(COMMA) &kp LS(DOT) &mt LCTRL SLASH
&kp LCTRL   &kp LGUI       &kp LALT      &trans         &trans  &trans                  &trans      &trans                                        &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        /* 左手は数字、右手はカーソル・編集・日本語入力切り替え。 */
        number_nav {
            display-name = "NUM_NAV";
            bindings = <
&kp ESC     &kp N7         &kp N8        &kp N9         &kp SLASH                       &kp HOME    &kp BSPC       &kp DEL       &kp END        &kp PG_UP
&kp TAB     &kp N4         &kp N5        &kp N6         &kp LS(SQT)           &trans     &kp LEFT    &kp DOWN       &kp UP        &kp RIGHT      &kp K_APP
&kp N0      &kp N1         &kp N2        &kp N3         &kp MINUS &trans      &trans     &kp LANG2   &kp LANG1      &kp GRAVE     &kp INSERT     &mt LCTRL PG_DN
&kp LCTRL   &kp LGUI       &kp LALT      &kp LSHIFT     &kp LS(SEMI) &kp LS(MINUS)       &trans      &trans                                        &trans
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        /* このレイヤーを押している間はトラックボールもスクロール。 */
        function {
            display-name = "FUNCTION";
            bindings = <
&trans      &kp F7         &kp F8        &kp F9         &kp F12                         &kp C       &trans         &trans        &none          &none
&kp LC(LG(TAB)) &kp F4     &kp F5        &kp F6         &kp F11               &trans     &kp LC(LG(TAB)) &kp C_PP   &kp C_VOL_UP  &none          &none
&kp LS(LA(TAB)) &kp F1     &kp F2        &kp F3         &kp F10 &trans        &trans     &kp LC(LEFT) &kp LC(RIGHT) &kp C_VOL_DN  &none          &none
&kp LC(LEFT) &trans        &tog ONISHI   &none          &trans  &trans                  &kp PSCRN   &mo NUMBER_NAV                               &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /* 左手の追加キーを押したまま操作。接続情報の消去は現在の接続先のみ。 */
        bluetooth {
            display-name = "BLE";
            bindings = <
&out OUT_USB &out OUT_BLE  &none         &none          &none                           &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
&none       &none          &none         &none          &none                 &none      &none       &none          &none         &none          &studio_unlock
&none       &none          &none         &none          &none   &trans        &none      &none       &none          &none         &none          &bt BT_CLR
&none       &none          &none         &none          &none   &none                   &none       &none                                         &none
            >;
            sensor-bindings = <&scroll_up_down>;
        };
    };
};
